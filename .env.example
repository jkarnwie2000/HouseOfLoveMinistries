# =============================================================================
#  House of Love International Ministries – environment configuration
#  Copy this file to ".env" (same folder) and fill in your values.
#  NEVER commit the real .env file – it contains secrets.
# =============================================================================

# ---- General ----------------------------------------------------------------
NODE_ENV=development
# Port the API server listens on
PORT=4242
# Public URL of the website (used for Stripe success/cancel redirects).
# Development: http://localhost:5173   Production: https://www.your-domain.org
CLIENT_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API (defaults to CLIENT_URL)
# CORS_ORIGINS=http://localhost:5173

# ---- Stripe (https://dashboard.stripe.com/test/apikeys) -----------------------
# Use TEST keys (sk_test_...) during development. Never expose the secret key.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret for the webhook endpoint (whsec_...). For local development run:
#   npm run stripe:listen   (forwards the 9 payment events the server handles)
# and paste the secret it prints here.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd

# ---- Admin authentication ------------------------------------------------------
# Long random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h
# First administrator – created automatically on first start if no users exist.
# Change the password after first sign-in by creating a new admin and disabling this one,
# or reset it with: npm run create-admin -- you@example.org "Your Name" admin
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_NAME=Site Administrator

# ---- Database ------------------------------------------------------------------
# "json"      – zero-setup file database (server/data/db.json). Good for local dev
#               and small single-server hosting with a persistent disk.
# "firestore" – Google Cloud Firestore (Firebase). Recommended for production.
DB_DRIVER=json
# JSON_DB_PATH=server/data/db.json

# Firestore service account (Firebase console → Project settings → Service accounts).
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n sequences exactly as in the downloaded JSON file.
FIREBASE_PRIVATE_KEY=

# ---- Email (order confirmations, donation receipts, notifications) -------------
# Any SMTP provider works (Google Workspace, Microsoft 365, SendGrid, Mailgun, Postmark…).
# Leave SMTP_HOST empty in development – emails are then printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="House of Love International Ministries <no-reply@your-domain.org>"
# Staff inbox that receives new-order and contact-form notifications
ORG_NOTIFY_EMAIL=

# ---- Uploads -------------------------------------------------------------------
# Where admin-uploaded product/event images are stored (must be persistent in production)
# UPLOAD_DIR=server/uploads

# ---- Production ----------------------------------------------------------------
# When true, the Express server also serves the built React app (client/dist).
# Defaults to true when NODE_ENV=production.
# SERVE_CLIENT=true

# ---- Frontend (exposed to the browser – never put secrets in VITE_ variables) --
# Only needed if the API is hosted on a different domain from the website.
# VITE_API_URL=https://api.your-domain.org
